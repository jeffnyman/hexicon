#charset "us-ascii"
import hexad;

/*
 *   Pictures and sounds.
 *
 *   A game names each as an object, and Hexad writes the markup that shows
 *   or plays it, on a display that can, and that the player has not told
 *   to leave them out. On one that cannot, a picture shows its pictureAlt
 *   text, if it has any, and a sound nothing at all.
 *
 *   The files are the game's resources, named in its manifest.
 */

/* Whether the display can show or play a file of this name's kind. */
displayCanUse(file)
{
    local ext = file.toLower();
    local dot = ext.findLast('.');
    ext = dot == nil ? '' : ext.substr(dot + 1);

    local code, pref;
    switch (ext)
    {
    case 'jpg':
    case 'jpeg':
        code = SysInfoJpeg;
        pref = SysInfoPrefImages;
        break;
    case 'png':
    /*
     *   SVG and WebP have no code of their own: Hexicon's rich display,
     *   which shows PNG, shows them too.
     */
    case 'svg':
    case 'webp':
        code = SysInfoPng;
        pref = SysInfoPrefImages;
        break;
    case 'mng':
        code = SysInfoMng;
        pref = SysInfoPrefImages;
        break;
    case 'wav':
        code = SysInfoWav;
        pref = SysInfoPrefSounds;
        break;
    case 'ogg':
        code = SysInfoOgg;
        pref = SysInfoPrefSounds;
        break;
    case 'mp3':
        code = SysInfoMpeg3;
        pref = SysInfoPrefSounds;
        break;
    case 'mid':
    case 'midi':
        code = SysInfoMidi;
        pref = SysInfoPrefMusic;
        break;
    default:
        return nil;
    }
    return systemInfoSays(code) && systemInfoSays(pref);
}

/* Whether systemInfo answers yes: a number other than 0. */
systemInfoSays(code)
{
    local val = systemInfo(code);
    return val != nil && val != 0;
}

/*
 *   A picture: Picture 'cave.jpg'. Its show() shows it, wherever the text
 *   it is called from has got to.
 */
class Picture: object
    /* The picture's file, among the game's resources. */
    pictureFile = nil

    /* What a display without pictures shows instead, or nil for nothing. */
    pictureAlt = nil

    /*
     *   Where it goes: nil for centered, on a line of its own; 'right' or
     *   'left' for that side, with the text running beside it.
     */
    pictureAlign = nil

    /* Whether show() shows it only the first time. */
    showsOnce = nil

    /*
     *   A command, for a picture that is a button: clicking it is typing
     *   the command. Nil for a picture that is only a picture.
     */
    pictureCommand = nil

    /*
     *   The pictures shown instead while the pointer is over it, and while
     *   it is pressed, among the game's resources; nil for none.
     */
    pictureHover = nil
    picturePressed = nil

    /* Whether it has been shown. */
    pictureShown = nil

    show()
    {
        if (showsOnce && pictureShown)
            return;
        pictureShown = true;

        if (!displayCanUse(pictureFile))
        {
            if (pictureAlt != nil)
                "<.p><<pictureAlt>><.p>";
            return;
        }

        /*
         *   In the class picture, which a style sheet can style: centered
         *   on a line of its own by default.
         */
        local alt = pictureAlt == nil ? '' : ' alt="' + pictureAlt + '"';
        local also = (pictureHover == nil ? '' : ' hsrc="' + pictureHover + '"')
            + (picturePressed == nil ? '' : ' asrc="' + picturePressed + '"')
            + alt;
        local open = pictureCommand == nil
            ? '' : '<a plain href="' + pictureCommand + '">';
        local close = pictureCommand == nil ? '' : '</a>';
        if (pictureAlign == nil)
            "<.p><div class=\"picture\"><<open>><img src=\"<<pictureFile>>\"<<
            also>>><<close>></div><.p>";
        else
            "<<open>><img class=\"picture\" src=\"<<pictureFile>>\"
            align=<<pictureAlign>> hspace=30<<also>>><<close>>";
    }
;

/*
 *   A sound: Sound 'drip.wav'. Its play() plays it; a room's roomSounds
 *   play while the player is there.
 */
class Sound: object
    /* The sound's file, among the game's resources. */
    soundFile = nil

    /*
     *   Its layer: 'foreground' for a sound that something makes happen
     *   (the default), 'ambient' for one of a place's sounds, 'bgambient'
     *   for a place's sound behind those, and 'background' for music. A
     *   sound in one layer does not stop one in another.
     */
    soundLayer = 'foreground'

    /* How many times it plays: a number, or 'loop' for over and over. */
    soundRepeat = 1

    /*
     *   For a sound that comes now and then, a bird or a drip: the chance,
     *   as a percentage, that the display plays it each time it considers
     *   it. Nil for a sound that plays straight away.
     */
    soundChance = nil

    /* Whether it stops what is playing in its layer, to play at once. */
    interrupts = nil

    /* How loud it is, from 0 to 100, or nil for as loud as it was made. */
    soundVolume = nil

    /*
     *   The seconds it takes to fade in when it starts, and to fade out at
     *   its end, or nil for none. A sound with a fade out fades out
     *   whenever it stops: at its end, or when its layer is stopped or
     *   another sound interrupts it.
     */
    soundFadeIn = nil
    soundFadeOut = nil

    play()
    {
        if (!displayCanUse(soundFile))
            return;
        "<sound src=\"<<soundFile>>\" layer=<<soundLayer>><<
          soundRepeat != 1 ? ' repeat=' + soundRepeat : ''>><<
          soundChance != nil ? ' random=' + soundChance : ''>><<
          soundVolume != nil ? ' volume=' + soundVolume : ''>><<
          soundFadeIn != nil ? ' fadein=' + soundFadeIn : ''>><<
          soundFadeOut != nil ? ' fadeout=' + soundFadeOut : ''>><<
          interrupts ? ' interrupt' : ''>>>";
    }
;

/*
 *   Stop the sounds playing in a layer: 'ambient', say. With a number of
 *   seconds, they fade out over that time.
 */
stopSoundLayer(layer, fadeOut?)
{
    if (systemInfoSays(SysInfoWav) || systemInfoSays(SysInfoOgg))
        "<sound cancel=<<layer>><<
          fadeOut != nil ? ' fadeout=' + fadeOut : ''>>>";
}

/*
 *   The sounds of the player's room: when the player is somewhere else,
 *   the last room's layers are stopped and the new room's sounds played.
 *   It is looked at before each prompt, so it follows the player however
 *   they got there.
 */
roomSoundPlayer: InitObject
    execute() { new PromptDaemon(self, &update); }

    update()
    {
        local room = now.player == nil ? nil : now.player.getOutermostRoom();
        local sounds = room == nil ? [] : valToList(room.roomSounds);
        local playing = roomSoundsPlaying.sounds;
        if (sounds == playing)
            return;
        foreach (local layer in playing.mapAll({ s: s.soundLayer }).getUnique())
            stopSoundLayer(layer);
        foreach (local s in sounds)
            s.play();
        roomSoundsPlaying.sounds = sounds;
    }
;

/*
 *   The room's sounds that are playing now, as the room's roomSounds gave
 *   them. This is what the display is doing, not part of the game, so it
 *   is transient: RESTART, RESTORE, and UNDO change the game, and not
 *   what is playing, and the next look at the player's room stops what
 *   it no longer has and plays what it does.
 */
transient roomSoundsPlaying: object
    sounds = []
;

modify Room
    /* The sounds that play while the player is here. */
    roomSounds = []
;
