f(p0)
{
    local a = [1], b = [2], c = [3], d = [4], e = [5], f6 = [6], g = [7];
    a[1] = 1; b[2] = 2; g[3] = 3; g[p0] = 4; a[p0] = 5; p0[1] = 6;
    a[200] = 1; a[1000] = 1;
    return a[1] + b[2] + g[3] + g[p0] + a[p0] + p0[1] + a[0] + a[200] + a[1000] + g[1000]
        + c + d + e + f6;
}
_main(args) { return f(1); }
