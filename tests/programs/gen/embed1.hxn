f() { return 1; }
g() { }
_main(args)
{
    "a<<1>>b"; "<<args>>"; "x<<f()>>"; "<<g()>>y"; "<<>>"; "a<<>>b<<  >>";
    "<<args>><<args>>"; "<<1, 2>>"; "<<args = 1>><<args += 2, args>>";
    "a<<"b<<1>>c">>d"; "<<'x<<1>>y'>>"; "<<'q<<"r<<args>>s">>t'>>";
    "a<<
      args
      + 1>>b
      c";
    "<<args ? "x" : "y">>c<<args ? f() : 1>><<args ? g() : g()>>";
    "<<[1, 2][1]>><<[args]>><<args[1]>><<f>><<nil>><<true>>";
}
