builtin 'hexicon-vm/010006'
{
    collectGarbage();
    setSay(val);
    vmVersion();
    vmId();
    vmBanner();
    inPreinit();
    debugTrace(mode, ...);
    globalSymbols(which?);
    newProperty();
    stackTrace(level?, flags?);
    namedArg(name, defval?);
    namedArgList();
}
builtin 'hexicon-gen/030008'
{
    typeOf(val);
    arg(idx);
    firstObj(cls?, flags?);
    nextObj(obj, cls?, flags?);
    randomize(...);
    rand(x, ...);
    toString(val, radix?, isSigned?);
    toInteger(val, radix?);
    getTime(timeType?);
    regexMatch(pat, str, index?);
    regexSearch(pat, str, index?);
    regexGroup(groupNum);
    regexReplace(pat, str, replacement, flags?, index?, limit?);
    savepoint();
    undo();
    saveGame(filename, metaTable?);
    restoreGame(filename);
    restartGame();
    max(val1, ...);
    min(val1, ...);
    repeatString(val, repeatCount?);
    functionParams(func);
}
builtin 'hexicon-io/030007'
{
    print(val, ...);
}
builtin class Object 'root-object/030004' { ofKind(cls); }
builtin class Collection 'collection/030000': Object { createIterator(); createLiveIterator(); }
builtin class List 'list/030008': Collection { length(); }

modify List
    second() { return self[2]; }
    describe() { return 'a list'; }
;
f() { return 1; }
modify Object
    hello() { return 'hello from ' + name; }
    name = 'something'
    made = static f()
;
modify List
    second() { return 'second: ' + inherited(); }
    third = 3
;
thing: object name = 'thing';
modify Collection count = 0;
modify List;
_main(args)
{
    local l = [1, 2, 3];
    print(l.second()); print(l.describe()); print(thing.hello());
    print(l.hello()); print(l.third); print(l.count);
}
