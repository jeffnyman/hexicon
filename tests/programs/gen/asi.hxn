f(a, b)
{
    local x, y, z;
    x = y = z = a;
    x = (y = 1) + (z = 2);
    x += y += z;
    x = y++ + ++z;
    x = y-- - --z;
    x = a++ + ++b;
    x = a-- - --b;
    a += 1; a -= 1; a *= 2; b = a += 3;
    x++; ++x; x--; --x; a++; ++a; a--; --a;
    y = x++; y = ++x; y = x--; y = --x; y = a++; y = ++a;
    y = (x += 1); y = (x += 100); y = (x += 1000); y = (x += z); y = (x -= z); y = (x -= 1);
    y = (x *= 2); y = (a *= 2); y = (a += 2); y = (a -= 2);
    x = nil; x = 0; x = 1; x = 2; y = (x = nil); y = (x = 0); y = (x = 1);
    a = nil; a = 0; a = 1; y = (a = nil);
    x = x; x = y; x = a; a = x; a = b;
    f = 1;
    return x + y + z;
}
_main(args) { return 1; }
