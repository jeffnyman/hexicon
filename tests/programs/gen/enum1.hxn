builtin 'hexicon-vm/010006'
{
    collectGarbage();
    setSay(val);
    vmVersion();
    vmId();
    vmBanner();
    inPreinit();
    debugTrace(mode, ...);
    globalSymbols(which?);
    newProperty();
    stackTrace(level?, flags?);
    namedArg(name, defval?);
    namedArgList();
}
builtin 'hexicon-gen/030008'
{
    typeOf(val);
    arg(idx);
    firstObj(cls?, flags?);
    nextObj(obj, cls?, flags?);
    randomize(...);
    rand(x, ...);
    toString(val, radix?, isSigned?);
    toInteger(val, radix?);
    getTime(timeType?);
    regexMatch(pat, str, index?);
    regexSearch(pat, str, index?);
    regexGroup(groupNum);
    regexReplace(pat, str, replacement, flags?, index?, limit?);
    savepoint();
    undo();
    saveGame(filename, metaTable?);
    restoreGame(filename);
    restartGame();
    max(val1, ...);
    min(val1, ...);
    repeatString(val, repeatCount?);
    functionParams(func);
}
builtin 'hexicon-io/030007'
{
    print(val, ...);
}

enum red, green, blue;
enum token tokWord, tokNum;
f(x) { return x == red ? 1 : 2; }
enum ab, ba, zz, a1, b0, later;
obj: object
    color = red
    list = [red, green, [blue, tokWord]]
    m() { return color == blue; }
;
_main(args)
{
    local c = green;
    switch (c) { case red: print('r'); break; case green: print('g'); break; case early: break; }
    // The reference never finds two of them equal when it compares
    // them itself.
    print(red == red ? 'eq' : 'ne');
    print(red != red ? 'ne2' : 'eq2');
    print(red == green ? 'eq3' : 'ne3');
    print([red, green] - red == [green] ? 'y' : 'n');
    print([red] == [red] ? 'y' : 'n');
    print(c == green ? 'y' : 'n');
    print((red ? 'T' : 'F') + (!red ? 'T' : 'F'));
    print(f(ab) + f(ba) + f(zz) + f(a1) + f(b0) + f(later) + f(early));
    if (red) print('!');
    local l = [ab, ba, zz, a1, b0, later, early, tokNum];
    return l.length() + (red is in (red, green) ? 1 : 0) + (red ?? 1) + (red, 1);
}
enum early;
enum red, tokWord;
enum token green;
