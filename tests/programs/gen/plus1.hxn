intrinsic 'hexicon-vm/010006'
{
    collectGarbage();
    setSay(val);
    vmVersion();
    vmId();
    vmBanner();
    inPreinit();
    debugTrace(mode, ...);
    globalSymbols(which?);
    newProperty();
    stackTrace(level?, flags?);
    namedArg(name, defval?);
    namedArgList();
}
intrinsic 'hexicon-gen/030008'
{
    typeOf(val);
    arg(idx);
    firstObj(cls?, flags?);
    nextObj(obj, cls?, flags?);
    randomize(...);
    rand(x, ...);
    toString(val, radix?, isSigned?);
    toInteger(val, radix?);
    getTime(timeType?);
    regexMatch(pat, str, index?);
    regexSearch(pat, str, index?);
    regexGroup(groupNum);
    regexReplace(pat, str, replacement, flags?, index?, limit?);
    savepoint();
    undo();
    saveGame(filename, metaTable?);
    restoreGame(filename);
    restartGame();
    max(val1, ...);
    min(val1, ...);
    repeatString(val, repeatCount?);
    functionParams(func);
}
intrinsic 'hexicon-io/030007'
{
    print(val, ...);
}

+ property location;
class Thing: object name = 'thing' location = nil;
hall: Thing;
+ table: Thing;
++ cup: Thing;
++ Thing name = 'anon';
+++ lid: Thing;
+ chair: Thing location = cup;
+ class Furniture: Thing;
++ onFurn: Thing;
class Plain: Thing;
+ afterClass: Thing;
+ transient ghost: Thing;
+ transient Thing;
+ object name = 'x';
modify table extra = 1;
++ underModify: Thing;
+ besideModify: Thing;
x2: Thing;
modify Thing more = 2;
+ y2: Thing;
replace cup: Thing;
+++ z: Thing;
++++ deep: Thing;
+ property loc2;
+ w: Thing;
object template 'name' @location;
+ Thing 'tpl' @hall;
+ both: Thing 'tpl' @hall loc2 = 5;
modify Object objExtra = 1;
+ underMeta: Thing;
+ Thing { name = 'braces' }
++ last: Thing;
_main(args) { print(lid.location.name); print(underModify.location.extra); print(last.loc2.name); }
