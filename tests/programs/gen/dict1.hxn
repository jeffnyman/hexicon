intrinsic 'hexicon-vm/010006'
{
    collectGarbage();
    setSay(val);
    vmVersion();
    vmId();
    vmBanner();
    inPreinit();
    debugTrace(mode, ...);
    globalSymbols(which?);
    newProperty();
    stackTrace(level?, flags?);
    namedArg(name, defval?);
    namedArgList();
}
intrinsic 'hexicon-gen/030008'
{
    typeOf(val);
    arg(idx);
    firstObj(cls?, flags?);
    nextObj(obj, cls?, flags?);
    randomize(...);
    rand(x, ...);
    toString(val, radix?, isSigned?);
    toInteger(val, radix?);
    getTime(timeType?);
    regexMatch(pat, str, index?);
    regexSearch(pat, str, index?);
    regexGroup(groupNum);
    regexReplace(pat, str, replacement, flags?, index?, limit?);
    savepoint();
    undo();
    saveGame(filename, metaTable?);
    restoreGame(filename);
    restartGame();
    max(val1, ...);
    min(val1, ...);
    repeatString(val, repeatCount?);
    functionParams(func);
}
intrinsic 'hexicon-io/030007'
{
    print(val, ...);
}

dictionary gDict;
dictionary property noun, adjective, plural;
class Thing: object
    noun = 'thing' 'object'
    name = 'x'
;
lamp: Thing
    noun = 'lamp' 'lantern' 'Lamp'
    adjective = 'brass' 'old'
;
key: Thing
    adjective = 'brass'
    noun = 'key'
;
Thing noun = 'anon' 'lamp';
plain: object name = 'plain';
class Sub: Thing plural = 'subs';
sub1: Sub noun = 'sub';
_main(args) { }
