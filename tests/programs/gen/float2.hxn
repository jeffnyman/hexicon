#include <decimal.h>
#include <hexicon.h>
obj: object
    half = 0.5
    big = 4294967296
    lst = [1.5, 2, 'x', 3.25e2]
    calc = (1.5 + 2)
    pat = R'a+b'
    pats = [R"x*", R'%d+']
;
show(v) { print(toString(v)); print(' '); }
_main(args)
{
    show(1.5 + 2.25); show(1.5 - 2); show(2 * 1.5); show(7.5 % 2);
    show(-1.5); show(-(-1.5)); show(+1.5); show(1e3); show(1.0e-3); show(.5); show(5.); print('\n');
    show(2147483647 + 1); show(-2147483647 - 2); show(2147483647 + 1 - 1); show(4294967296 - 4294967295);
    show(0x7fffffff + 1); show(0xffffffff); show(0x100000000); show(077777777777); show(-2147483648); show(-(-2147483648)); print('\n');
    show(1.5 < 2); show(2.5 > 2.25); show(1.0 == 1); show(1 == 1.0); show(1.5 != 1.5); show(2147483648 >= 2147483647);
    show(1.5 ? 'y' : 'n'); show(0.0 ? 'y' : 'n'); show(!0.0); show(!1.5); show(0.0 && 1); show(0.5 || nil); print('\n');
    show('a' + 1.5); show(1.5 + 'a'); show('v' + 2147483648); show([1] + 1.5); show([1.5, 2.5] - 1.5); show(1.5 is in (1, 1.5));
    show(obj.half); show(obj.big); show(obj.lst[4]); show(obj.calc); show(1.50 == 1.5); show(1.5.getWhole()); print('\n');
    show(4294967296 * 2); show(4294967296 / 4294967296); show(2147483648 / 2);
    show(1.23456789012345678901234567890 + 1); show(100000 * 100000); show(-2147483648 / 1);
    show(3000000000); show(3000000000 - 1000000000); show(1e10 - 1e10 + 5); print('\n');
    for (local i in 1..2 step 0.5) show(i);
    for (local i in 2..1 step -0.5) show(i);
    switch (1.5) { case 1.5: show('case'); break; default: show('default'); }
    show(regexMatch(obj.pat, 'aaab')); show(regexMatch(R'%d+', '123x')); show(regexMatch(obj.pats[1], 'xxxy')); print('\n');
}
