builtin 'hexicon-gen/030008'
{
    typeOf(val); arg(idx); firstObj(cls?, flags?); nextObj(obj, cls?, flags?);
    randomize(...); rand(x, ...); toString(val, radix?, isSigned?); toInteger(val, radix?);
    getTime(typ?); regexMatch(pat, str, idx?); regexSearch(pat, str, idx?); regexGroup(n);
    regexReplace(pat, str, repl, flags?, idx?); savepoint(); undo(); saveGame(fname, metaTab?);
    restoreGame(fname); restartGame(); max(val, ...); min(val, ...); repeatString(val, rpt?);
    functionParams(func); toNumber(val, radix?); sprintf(fmt, ...);
}

_main(args)
{
    "<<%d args>> <<%5.2f args + 1>><<%s 'x' >><<% d 5>><<%-5.2f 1>><<%% 3>>";
    "<<%x args, 2>><<%d if>><<if args>><<%d args>><<end>>";
    local s = '<<%x args>>' + '<<%s s>><<%c 65>>';
    local sprintf = 1;
    "<<%d args>>";
    return s + sprintf;
}
