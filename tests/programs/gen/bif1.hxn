builtin 'hexicon-vm/010006'
{
    collectGarbage();
    setSay(val);
    vmVersion();
    vmId();
    vmBanner();
    inPreinit();
    debugTrace(mode, ...);
    globalSymbols(which?);
    newProperty();
    stackTrace(level?, flags?);
    namedArg(name, defval?);
    namedArgList();
}
builtin 'hexicon-gen/030008'
{
    typeOf(val);
    arg(idx);
    firstObj(cls?, flags?);
    nextObj(obj, cls?, flags?);
    randomize(...);
    rand(x, ...);
    toString(val, radix?, isSigned?);
    toInteger(val, radix?);
    getTime(timeType?);
    regexMatch(pat, str, index?);
    regexSearch(pat, str, index?);
    regexGroup(groupNum);
    regexReplace(pat, str, replacement, flags?, index?, limit?);
    savepoint();
    undo();
    saveGame(filename, metaTable?);
    restoreGame(filename);
    restartGame();
    max(val1, ...);
    min(val1, ...);
    repeatString(val, repeatCount?);
    functionParams(func);
}
builtin 'hexicon-io/030007'
{
    print(val, ...);
}

_main(args)
{
    print('hello
');
    print('a', 'b', 1);
    local t = typeOf(args);
    local m = max(1, 2, 3) + min(4, 5);
    local s = toString(m) + toString(m, 16) + toString(m, 16, nil);
    collectGarbage();
    collectGarbage;
    local v = vmVersion;
    print(args...);
    print(t, args..., s, v);
    return arg(1) + rand(10);
}
