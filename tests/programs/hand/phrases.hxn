// A program to run: grammar productions, which say how phrases are made
// up of words, and the objects made when a phrase is matched.
#include <systype.h>
#include <general.h>
#include <io.h>
#include <vm.h>
#include <dict.h>
#include <gramprod.h>

// Results go one to a line.
line(val) { print(toString(val)); print('\n'); }

dictionary gDict;
dictionary property noun, adjective;

// The kinds of token a phrase is matched against.
enum token tokWord;

lamp: object noun = 'lamp' 'lantern' adjective = 'brass';
box: object noun = 'box' adjective = 'wooden' 'brass';

// What every match is a kind of.
class Phrase: object
    describe() { return grammarTag; }
;

// A `grammar` statement names a production and, in parentheses, this
// way of making it up; then what to match, each with the property the
// match is kept in after `->`; then the class of the object to make.
// A dictionary property matches any word the dictionary has for it.
grammar nounPhrase(plain): noun->noun_ : Phrase
    describe() { return noun_; }
;

// A production's name matches a phrase of that production.
grammar nounPhrase(described): adjective->adj_ nounPhrase->np_ : Phrase
    describe() { return adj_ + ' ' + np_.describe(); }
;

// A string matches the word itself.
grammar nounPhrase(definite): 'the' nounPhrase->np_ : Phrase
    describe() { return np_.describe(); }
;

// `|` separates alternatives, and parentheses group them inside a row.
grammar command(take): ('take' | 'get' | 'pick' 'up') nounPhrase->dobj_ : Phrase
    describe() { return 'take [' + dobj_.describe() + ']'; }
;

grammar command(put): 'put' nounPhrase->dobj_ ('in' | 'into') nounPhrase->iobj_ : Phrase
    describe() { return 'put [' + dobj_.describe() + '] in [' + iobj_.describe() + ']'; }
;

// `[badness n]` marks a way that is a last resort.
grammar command(look): 'look' | [badness 100] 'l' : Phrase
    describe() { return 'look'; }
;

// Read a command: its words as tokens, and the whole-command matches.
parse(text)
{
    local toks = text.split(' ').mapAll({word: [word, tokWord, word]});
    local matches = command.parseTokens(toks, gDict)
        .subset({match: match.lastTokenIndex == toks.length()});
    if (matches.length() == 0)
        return 'not understood';
    return matches.mapAll({match: match.describe()}).join('; ');
}

_main(args)
{
    line(parse('take lamp'));
    line(parse('get the brass lantern'));
    line(parse('pick up box'));
    line(parse('put the lamp in the wooden box'));
    line(parse('put brass box into box'));
    line(parse('look'));
    line(parse('l'));
    line(parse('take'));
    line(parse('eat lamp'));

    // How many ways each production can be made up, with the groups
    // in parentheses written out as a row for every choice.
    line(command.getGrammarInfo().length());
    line(nounPhrase.getGrammarInfo().length());
}
