// A program to run: multi-methods, which are functions chosen by the
// kinds of their arguments.
#include <systype.h>
#include <general.h>
#include <io.h>
#include <vm.h>

// Results go one to a line.
line(val) { print(toString(val)); print('\n'); }

// ---- what the system library does for multi-methods, in little ----
//
// The compiler writes code that calls these. The library's own are
// faster and cleverer; these keep a list and take the version that
// fits with the most particular types.

// Each version: the multi-method, the version's function, the types
// of its parameters, and how particular the types are.
versions: object
    all = []
;

// How far down from the top a class is.
depth(cls)
{
    local sc = cls.getSuperclassList();
    return sc.length() == 0 ? 1 : depth(sc[1]) + 1;
}

// Called before the program starts, once for each version.
_multiMethodRegister(base, func, params)
{
    local score = 0;
    foreach (local param in params)
        score += (param == nil ? 0 : depth(param));
    versions.all += [[base, func, params, score]];
}

// Called when every version has been registered.
_multiMethodBuildBindings() { }

// Whether a version's parameters fit some arguments. A parameter with
// no type takes anything.
fits(params, args)
{
    if (params.length() != args.length())
        return nil;
    for (local i = 1 ; i <= params.length() ; ++i)
    {
        if (params[i] != nil
            && !(dataType(args[i]) == TypeObject && args[i].ofKind(params[i])))
            return nil;
    }
    return true;
}

// The most particular version of a multi-method that fits, among
// those less particular than `limit`.
pick(base, args, limit)
{
    local best = nil;
    foreach (local version in versions.all)
    {
        if (version[1] == base
            && fits(version[3], args)
            && (limit == nil || version[4] < limit)
            && (best == nil || version[4] > best[4]))
            best = version;
    }
    return best;
}

// A call to a multi-method comes here, with the arguments in a list.
_multiMethodCall(base, args)
{
    local version = pick(base, args, nil);
    return version == nil ? 'no version fits' : (version[2])(args...);
}

// `inherited(args)` in a version comes here: the next most particular
// version that fits.
_multiMethodCallInherited(from, [args])
{
    foreach (local cur in versions.all)
    {
        if (cur[2] == from)
        {
            local version = pick(cur[1], args, cur[4]);
            return version == nil ? 'nothing more' : (version[2])(args...);
        }
    }
    return 'nothing more';
}

// ---- the program ----

class Thing: object name = 'thing';
class Liquid: Thing name = 'liquid';
class Vessel: Thing name = 'vessel';

water: Liquid name = 'water';
cup: Vessel name = 'cup';
rock: Thing name = 'rock';

// A function with types for its parameters is one version of a
// multi-method; a call goes to the version whose types fit best.
putIn(Liquid what, Vessel where)
{
    return 'pour the ' + what.name + ' into the ' + where.name;
}

putIn(Thing what, Vessel where)
{
    // `inherited` is the next version that fits.
    return 'drop the ' + what.name + ' in the ' + where.name + '; then ' + inherited(what, where);
}

// A parameter with no type takes anything.
putIn(Thing what, where)
{
    return 'the ' + what.name + ' cannot go there';
}

// `inherited<types>` is the version for exactly those types.
describe(Liquid what) { return 'wet ' + inherited<Thing>(what); }
describe(Thing what) { return what.name; }

// With no types at all, `multimethod` after the parameters says the
// function is a version all the same.
describe(what) multimethod { return 'something'; }

_main(args)
{
    line(putIn(water, cup));
    line(putIn(rock, cup));
    line(putIn(rock, water));
    line(putIn(cup, 5));
    line(putIn(5, cup));
    line(describe(water));
    line(describe(rock));
    line(describe(42));

    // A multi-method is a function like any other.
    local f = describe;
    line(f(cup));
}
