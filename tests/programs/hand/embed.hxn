// A program to run: expressions embedded in strings, saying what they
// come to.
intrinsic 'hexicon-vm/010006'
{
    collectGarbage();
    setSay(val);
}
intrinsic 'hexicon-gen/030008'
{
    typeOf(val);
    arg(idx);
    firstObj(cls?, flags?);
    nextObj(obj, cls?, flags?);
    randomize(...);
    rand(x, ...);
    toString(val, radix?, isSigned?);
    toInteger(val, radix?);
    getTime(timeType?);
    regexMatch(pat, str, index?);
    regexSearch(pat, str, index?);
    regexGroup(groupNum);
    regexReplace(pat, str, replacement, flags?, index?, limit?);
    savepoint();
    undo();
    saveGame(filename, metaTable?);
    restoreGame(filename);
    restartGame();
    max(val1, ...);
    min(val1, ...);
    repeatString(val, repeatCount?);
    functionParams(func);
    toNumber(val, radix?);
    sprintf(format, ...);
}
intrinsic 'hexicon-io/030007'
{
    print(val, ...);
}

string template <<* doubled>> doubled;
string template <<the * in brackets>> bracketed;
string template <<a line>> line;

say(val) { print(val); }

doubled(x) { return x * 2; }
bracketed(x) { return '[<<x>>]'; }
line() { return '----'; }

// Displays something, and has no value to display.
aside() { "(an aside) "; }

size(n)
{
    return 'It is <<if n > 100>>large<<else if n > 10>>middling<<else>>small<<end>>.';
}

describe(n)
{
    "<<n>> is <<unless n % 2>>even<<otherwise>>odd<<end>><<if n > 2>>, and more than two";
    "\n";
}

_main(args)
{
    setSay(say);
    local n = 3;
    "One and two make <<1 + 2>>, and n is <<n>>.\n";
    "A list: <<[n, n + 1]>>. A string: <<'in quotes'>>. Nothing: <<nil>>.\n";
    "<<aside()>>and then the rest.\n";
    "Inside: <<"a string of its own, with <<n * n>> in it">>.\n";
    print('Joined: <<n>> and <<n + 1>>, <<'nested <<n + 2>>'>>.\n');
    print(size(5) + ' ' + size(50) + ' ' + size(500) + '\n');
    describe(2);
    describe(3);
    "Formatted: <<%05d n>>, <<%x 255>>, <<%s 'text'>>.\n";
    "Templates: <<n doubled>>, <<the n doubled in brackets>>, <<a line>>.\n";
    "<<if n == 3>>Three<<if n > 2>>, which is more than two<<end>>.<<else>>Not three.<<end>>\n";
}
