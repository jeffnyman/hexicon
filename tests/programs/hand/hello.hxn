// A program that says something: built-in functions, strings to
// display, and lists.
intrinsic 'hexicon-vm/010006'
{
    collectGarbage();
    setSay(val);
}
intrinsic 'hexicon-gen/030008'
{
    typeOf(val);
    arg(idx);
    firstObj(cls?, flags?);
    nextObj(obj, cls?, flags?);
    randomize(...);
    rand(x, ...);
    toString(val, radix?, isSigned?);
}
intrinsic 'hexicon-io/030007'
{
    print(val, ...);
}

say(val) { print(val); }

fib(n) { return n < 2 ? n : fib(n - 1) + fib(n - 2); }

sum(lst, count)
{
    local total = 0;
    for (local i = 1 ; i <= count ; ++i)
        total += lst[i];
    return total;
}

_main(args)
{
    setSay(say);
    "Hello from Hexicon!\n";
    local numbers = [];
    for (local i = 1 ; i <= 10 ; ++i)
        numbers += fib(i);
    numbers[3] = 100;
    print('The sum is ' + toString(sum(numbers, 10)) + '.\n');
    local words = ['one', 'two', 'three'];
    for (local i = 1 ; i <= 3 ; ++i)
    {
        print(words[i]);
        if (i < 3) ", "; else ".\n";
    }
}
