// A program to run: object templates, which let an object definition
// start with values and no property names; names declared ahead of
// their definitions; and objects that are not saved.
#include <systype.h>
#include <general.h>
#include <io.h>
#include <vm.h>

// Declared here, defined further down.
extern function describe(thing);
extern class Room;
extern object lobby;

say(val) { print(val); }

// Results go one to a line.
line(val) { print(val); print('\n'); }

// A template any object can use: a name in single quotes, and then
// perhaps a description in double quotes.
object template 'name' "desc"?;

class Thing: object
    name = 'thing'
    vocab = nil
    location = nil
    weight = 1
    desc = "Nothing special."
;

// Templates for things. A value's kind says which property it is for:
// a string in single quotes, one in double quotes, a list, or an
// operator and then a value. `?` marks a value that can be left out,
// and `|` separates alternatives.
Thing template 'name' 'vocab'? @location? "desc"?;
Thing template +weight 'name' | "desc";

class Room: Thing
    exits = []
    north = nil
;

// `inherited` stands for each of the templates a room has from Thing
// in turn, so a room can have any of those and then its exits.
Room template inherited [exits];
Room template 'name' ->north;

lobby: Room 'Lobby' "A wide lobby with a marble floor." ;
office: Room 'Office' ->lobby;
vault: Room 'Vault' 'steel vault' [lobby, office];

lamp: Thing 'lamp' 'brass lamp' @lobby "It gives a warm light.";
key: Thing 'key' @office;
Thing 'coin' 'gold coin' @vault;
stone: Thing +50 'stone';
riddle: Thing +0 "It weighs nothing, and yet you cannot lift it.";

// A value can be worked out when it is asked for, and a description
// can have expressions in it.
scale: Thing 'scale' 'kitchen scale' @lobby
    "It reads <<stone.weight + lamp.weight>>."
;

// The values can go inside the braces.
box: Thing { 'box' 'wooden box' weight = 9 }

// An object with no class uses the template any object can.
object 'nobody' "Nobody in particular.";

// Not saved with the rest, and so not restored either.
transient session: Thing 'session' 'this session';

describe(thing)
{
    say(thing.name);
    say(thing.vocab == nil ? '' : ' (' + thing.vocab + ')');
    say(thing.location == nil ? '' : ' in the ' + thing.location.name);
    say(': ');
    thing.desc;
    say('\n');
}

_main(args)
{
    setSay(say);
    describe(lobby);
    describe(office);
    describe(vault);
    describe(lamp);
    describe(key);
    describe(stone);
    describe(riddle);
    describe(scale);
    describe(box);
    describe(session);
    line(office.north.name);
    line(vault.exits.length());
    line(stone.weight);
    line(box.weight);
    line(new Room().name);
    line(lobby.ofKind(Thing) ? 'a room is a thing' : 'a room is not a thing');
}
